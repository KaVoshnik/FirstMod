<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>netstandard2.1</TargetFramework>
        <LangVersion>latest</LangVersion>
        <GameManaged>D:\SteamLibrary\steamapps\common\Risk of Rain 2\Risk of Rain 2_Data\Managed</GameManaged>
        <ProfileBepInEx>C:\Users\Administrator\AppData\Roaming\Thunderstore Mod Manager\DataFolder\RiskOfRain2\profiles\Default\BepInEx</ProfileBepInEx>
    </PropertyGroup>

    <ItemGroup>
        <Reference Include="RoR2">
            <HintPath>$(GameManaged)\RoR2.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <Reference Include="UnityEngine">
            <HintPath>$(GameManaged)\UnityEngine.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <Reference Include="UnityEngine.CoreModule">
            <HintPath>$(GameManaged)\UnityEngine.CoreModule.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <Reference Include="UnityEngine.InputLegacyModule">
            <HintPath>$(GameManaged)\UnityEngine.InputLegacyModule.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <Reference Include="com.unity.multiplayer-hlapi.Runtime">
            <HintPath>$(GameManaged)\com.unity.multiplayer-hlapi.Runtime.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <Reference Include="UnityEngine.IMGUIModule">
            <HintPath>$(GameManaged)\UnityEngine.IMGUIModule.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <Reference Include="BepInEx">
            <HintPath>$(ProfileBepInEx)\core\BepInEx.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <Reference Include="0Harmony">
            <HintPath>$(ProfileBepInEx)\core\0Harmony.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <Reference Include="MMHOOK_RoR2">
            <HintPath>$(ProfileBepInEx)\plugins\MMHOOK\MMHOOK_RoR2.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <Reference Include="Rewired_Core">
            <HintPath>$(GameManaged)\Rewired_Core.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <Reference Include="HGCSharpUtils">
            <HintPath>$(GameManaged)\HGCSharpUtils.dll</HintPath>
            <Private>False</Private>
        </Reference>
        <Reference Include="UnityEngine.TextRenderingModule">
            <HintPath>$(GameManaged)\UnityEngine.TextRenderingModule.dll</HintPath>
            <Private>False</Private>
        </Reference>
    </ItemGroup>

    <Target Name="CopyToPlugins" AfterTargets="Build">
        <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(ProfileBepInEx)\plugins\FirstMod" />
    </Target>

</Project>
